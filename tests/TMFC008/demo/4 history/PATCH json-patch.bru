meta {
  name: PATCH json-patch: rename
  type: http
  seq: 3
}

patch {
  url: {{A_ID_href}}
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json-patch+json
}

body:json {
  [ { "op": "replace", "path": "/name", "value": "demo-A vCPE (renamed)" } ]
}

script:pre-request {
  if (!bru.getVar('history_enabled')) { bru.runner.skipRequest(); }
}

tests {
  test("patched", function () {
    expect(res.status).to.equal(200);
    expect(res.body.name).to.equal('demo-A vCPE (renamed)');
  });
}

docs {
  JSON Patch (RFC 6902); revision 2 is archived.
}

settings {
  encodeUrl: true
  timeout: 0
}
