meta {
  name: history with a reference filter (400)
  type: http
  seq: 14
}

get {
  url: {{tmfc008_base_url}}/service?includeHistory=true&serviceRelationship.service.state=active
  body: none
  auth: inherit
}

params:query {
  includeHistory: true
  serviceRelationship.service.state: active
}

script:pre-request {
  if (!bru.getVar('history_enabled')) { bru.runner.skipRequest(); }
}

tests {
  test("400", function () { expect(res.status).to.equal(400); });
}

docs {
  Filters through references are not supported on history (a reference always resolves to the current service).
}

settings {
  encodeUrl: true
  timeout: 0
}
