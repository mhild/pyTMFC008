meta {
  name: GET by id: revision 1
  type: http
  seq: 9
}

get {
  url: {{tmfc008_base_url}}/service/{{A_ID}}?includeHistory=true&revision=1
  body: none
  auth: inherit
}

params:query {
  includeHistory: true
  revision: 1
}

script:pre-request {
  if (!bru.getVar('history_enabled')) { bru.runner.skipRequest(); }
}

tests {
  test("the first revision with its revision data", function () {
    expect(res.status).to.equal(200);
    expect(res.body.state).to.equal('active');
    expect(res.body.revision.id).to.equal(1);
    expect(res.body.revision.startTimestamp).to.be.a('string');
    expect(res.body.revision.endTimestamp).to.be.a('string');
  });
}

docs {
  By id the revision has to be named: `includeHistory=true&revision=N`.
}

settings {
  encodeUrl: true
  timeout: 0
}
