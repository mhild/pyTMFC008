meta {
  name: GET by id: current revision 3
  type: http
  seq: 10
}

get {
  url: {{tmfc008_base_url}}/service/{{A_ID}}?includeHistory=true&revision=3
  body: none
  auth: inherit
}

params:query {
  includeHistory: true
  revision: 3
}

script:pre-request {
  if (!bru.getVar('history_enabled')) { bru.runner.skipRequest(); }
}

tests {
  test("the current version, without revision data", function () {
    expect(res.status).to.equal(200);
    expect(res.body.name).to.equal('demo-A vCPE (renamed)');
    expect(res.body.revision).to.equal(undefined);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
