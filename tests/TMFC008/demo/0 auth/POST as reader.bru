meta {
  name: POST /service as reader (403)
  type: http
  seq: 3
}

post {
  url: {{tmfc008_base_url}}/service
  body: json
  auth: inherit
}

body:json {
  {
    "@type": "Service",
    "serviceType": "Demo-auth-{{demo_run}}",
    "name": "demo-auth",
    "state": "active",
    "startDate": "2024-06-01T00:00:00Z",
    "serviceSpecification": { "id": "vcpe-spec-1", "name": "vCPE", "@type": "ServiceSpecificationRef" },
    "serviceCharacteristic": [
      { "name": "mac", "valueType": "string", "value": "{{mac_c}}", "@type": "StringCharacteristic" },
      { "name": "vlan", "valueType": "integer", "value": 300, "@type": "IntegerCharacteristic" }
    ],
    "relatedParty": [
      { "role": "user", "@type": "RelatedPartyRefOrPartyRoleRef",
         "partyOrPartyRole": { "id": "party-anna-müller", "name": "Anna Müller", "@type": "PartyRef" } }
    ]
  }
}

script:pre-request {
  if ((bru.getEnvVar('auth_mode') || 'none') === 'none') { bru.runner.skipRequest(); }
}

tests {
  test("reader may not create", function () { expect(res.status).to.equal(403); });
}

settings {
  encodeUrl: true
  timeout: 0
}
