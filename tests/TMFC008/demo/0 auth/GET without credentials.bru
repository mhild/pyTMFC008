meta {
  name: GET /service without credentials (401)
  type: http
  seq: 1
}

get {
  url: {{tmfc008_base_url}}/service
  body: none
  auth: inherit
}

params:query {
  limit: 1
}

script:pre-request {
  if ((bru.getEnvVar('auth_mode') || 'none') === 'none') { bru.runner.skipRequest(); }
  req.deleteHeader('Authorization');
}

script:post-response {
  bru.setVar('auth_as', 'reader');   // the next requests run as the read-only user
}

tests {
  test("401 with a challenge in TMF error format", function () {
    expect(res.status).to.equal(401);
    expect(res.headers['www-authenticate']).to.match(/^(Basic|Bearer)/);
    expect(res.body['@type']).to.equal('Error');
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
