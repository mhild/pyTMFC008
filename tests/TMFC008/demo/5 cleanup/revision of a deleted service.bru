meta {
  name: history of the deleted service
  type: http
  seq: 5
}

get {
  url: {{tmfc008_base_url}}/service/{{A_ID}}?includeHistory=true&revision=3
  body: none
  auth: inherit
}

params:query {
  includeHistory: true
  revision: 3
}

script:pre-request {
  if (!bru.getVar('history_enabled')) { bru.runner.skipRequest(); }
}

tests {
  test("the last revision is kept (archived by the delete)", function () {
    expect(res.status).to.equal(200);
    expect(res.body.name).to.equal('demo-A vCPE (renamed)');
    expect(res.body.revision.id).to.equal(3);
  });
}

docs {
  The delete archives the last version: the service is gone, its history is not. (The demo leaves these history rows behind.)
}

settings {
  encodeUrl: true
  timeout: 0
}
