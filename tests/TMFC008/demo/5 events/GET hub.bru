meta {
  name: GET /hub/{id}
  type: http
  seq: 3
}

get {
  url: {{tmfc008_base_url}}/hub/{{HUB_STATE}}
  body: none
  auth: inherit
}

script:pre-request {
  if (!bru.getVar('events_available')) { bru.runner.skipRequest(); }
}

tests {
  test("the subscription", function () {
    expect(res.status).to.equal(200);
    expect(res.body.query).to.contain('ServiceStateChangeEvent');
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
