meta {
  name: name and value of different elements do not match
  type: http
  seq: 5
}

get {
  url: {{tmfc008_base_url}}/service?serviceType=Demo-{{demo_run}}&serviceCharacteristic.name=vlan&serviceCharacteristic.value={{mac_a}}
  body: none
  auth: inherit
}

params:query {
  serviceType: Demo-{{demo_run}}
  serviceCharacteristic.name: vlan
  serviceCharacteristic.value: {{mac_a}}
}

tests {
  test("finds nothing", function () {
    expect([200, 206]).to.include(res.status);
    expect(res.body.map(s => s.name.replace('demo-', '').slice(0, 1)).sort()).to.deep.equal([]);
  });
}

docs {
  `vlan` exists and so does the MAC value, but in different characteristics: no match.
}

settings {
  encodeUrl: true
  timeout: 0
}
