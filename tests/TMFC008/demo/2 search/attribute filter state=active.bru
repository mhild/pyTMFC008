meta {
  name: attribute filter state=active
  type: http
  seq: 1
}

get {
  url: {{tmfc008_base_url}}/service?serviceType=Demo-{{demo_run}}&state=active
  body: none
  auth: inherit
}

params:query {
  serviceType: Demo-{{demo_run}}
  state: active
}

tests {
  test("finds A, B", function () {
    expect([200, 206]).to.include(res.status);
    expect(res.body.map(s => s.name.replace('demo-', '').slice(0, 1)).sort()).to.deep.equal(['A', 'B']);
  });
}

docs {
  Any attribute is a filter: `?state=active`.
}

settings {
  encodeUrl: true
  timeout: 0
}
