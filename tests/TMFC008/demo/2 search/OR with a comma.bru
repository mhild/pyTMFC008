meta {
  name: OR with a comma
  type: http
  seq: 2
}

get {
  url: {{tmfc008_base_url}}/service?serviceType=Demo-{{demo_run}}&state=active,inactive
  body: none
  auth: inherit
}

params:query {
  serviceType: Demo-{{demo_run}}
  state: active,inactive
}

tests {
  test("finds A, B, C", function () {
    expect([200, 206]).to.include(res.status);
    expect(res.body.map(s => s.name.replace('demo-', '').slice(0, 1)).sort()).to.deep.equal(['A', 'B', 'C']);
  });
}

docs {
  A comma separates alternatives (OR): `?state=active,inactive`.
}

settings {
  encodeUrl: true
  timeout: 0
}
