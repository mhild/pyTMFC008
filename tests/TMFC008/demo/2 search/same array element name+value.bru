meta {
  name: same array element name+value
  type: http
  seq: 4
}

get {
  url: {{tmfc008_base_url}}/service?serviceType=Demo-{{demo_run}}&serviceCharacteristic.name=mac&serviceCharacteristic.value={{mac_a}}
  body: none
  auth: inherit
}

params:query {
  serviceType: Demo-{{demo_run}}
  serviceCharacteristic.name: mac
  serviceCharacteristic.value: {{mac_a}}
}

tests {
  test("finds A", function () {
    expect([200, 206]).to.include(res.status);
    expect(res.body.map(s => s.name.replace('demo-', '').slice(0, 1)).sort()).to.deep.equal(['A']);
  });
}

docs {
  Several conditions on the same array path apply to the **same element**: the characteristic named `mac` that has this value.
}

settings {
  encodeUrl: true
  timeout: 0
}
