meta {
  name: GET /service/{id}
  type: http
  seq: 16
}

get {
  url: {{A_ID_href}}
  body: none
  auth: inherit
}

tests {
  test("the service", function () {
    expect(res.status).to.equal(200);
    expect(res.body.id).to.equal(bru.getVar('A_ID'));
    expect(res.body.name).to.equal('demo-A vCPE');
    expect(res.body.revision).to.equal(undefined);  // the current version carries no revision attributes
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
