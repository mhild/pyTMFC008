meta {
  name: POST /hub
  type: http
  seq: 12
}

post {
  url: {{tmfc008_base_url}}/hub
  body: json
  auth: inherit
}

body:json {
  {
    "callback": "http://127.0.0.1:9000/listener-demo",
    "query": "eventType=ServiceStateChangeEvent,ServiceDeleteEvent&event.service.serviceType=Cloud"
  }
}

assert {
  res.status: eq 201
}

script:post-response {
  bru.setEnvVar('HUB_ID', res.getBody().id);
}

settings {
  encodeUrl: true
  timeout: 0
}
