POSTGRES_USER=app
POSTGRES_PASSWORD=secret
POSTGRES_DB=app_db
ORACLE_PASSWORD=secret
ORACLE_APP_USER=app
ORACLE_APP_PASSWORD=secret
SQL_ECHO=false

# Keep earlier revisions of services (see README, *Revision history*). Best set from the start.
HISTORY_ENABLED=false

# Ports published on the host (the container-internal ports stay the same)
#APP_PORT=8080
#POSTGRES_PORT=5432
#ORACLE_PORT=1521
#KEYCLOAK_PORT=8180
# How clients reach Keycloak (profile keycloak) - it becomes the issuer of the tokens: OAUTH2_ISSUER=<this>/realms/tmf
#KEYCLOAK_PUBLIC_URL=http://localhost:8180

# Authentication of the API: none | basic | oauth2 (README, *Authentication*)
AUTH_MODE=none
#AUTH_BASIC_USERS=writer:writer-secret:read+write,reader:reader-secret:read
#OAUTH2_ISSUER=http://localhost:8180/realms/tmf
#OAUTH2_JWKS_URL=http://keycloak:8080/realms/tmf/protocol/openid-connect/certs

# Select the backend (hostnames are the compose service names):
DATABASE_URL=postgresql+asyncpg://app:secret@db:5432/app_db
#DATABASE_URL=oracle+oracledb_async://app:secret@oracle:1521/?service_name=FREEPDB1
