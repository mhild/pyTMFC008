{
  "realm": "tmf",
  "enabled": true,
  "sslRequired": "none",
  "accessTokenLifespan": 300,
  "roles": {
    "realm": [
      { "name": "inventory-read", "description": "May read services and subscribe to events" },
      { "name": "inventory-write", "description": "May create, change and delete services" }
    ]
  },
  "clients": [
    {
      "clientId": "tmf-reader",
      "name": "Demo system with read access (client credentials)",
      "enabled": true,
      "publicClient": false,
      "secret": "reader-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false
    },
    {
      "clientId": "tmf-writer",
      "name": "Demo system with write access (client credentials)",
      "enabled": true,
      "publicClient": false,
      "secret": "writer-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false
    },
    {
      "clientId": "tmf-demo",
      "name": "Demo client for users (password grant - for trying things out only)",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true
    }
  ],
  "users": [
    {
      "username": "service-account-tmf-reader",
      "enabled": true,
      "serviceAccountClientId": "tmf-reader",
      "realmRoles": ["inventory-read"]
    },
    {
      "username": "service-account-tmf-writer",
      "enabled": true,
      "serviceAccountClientId": "tmf-writer",
      "realmRoles": ["inventory-read", "inventory-write"]
    },
    {
      "username": "bob",
      "enabled": true,
      "email": "bob@example.org",
      "emailVerified": true,
      "firstName": "Bob",
      "lastName": "Reader",
      "credentials": [{ "type": "password", "value": "bob", "temporary": false }],
      "realmRoles": ["inventory-read"]
    },
    {
      "username": "alice",
      "enabled": true,
      "email": "alice@example.org",
      "emailVerified": true,
      "firstName": "Alice",
      "lastName": "Writer",
      "credentials": [{ "type": "password", "value": "alice", "temporary": false }],
      "realmRoles": ["inventory-read", "inventory-write"]
    }
  ]
}
